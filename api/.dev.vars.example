# Copy to api/.dev.vars (git-ignored). Fake values only; put real keys there yourself.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322
RAZORPAY_ENV=test
# Run fully offline (no Supabase, no AI keys, dev tokens "dev.<uuid>"):
USE_MEMORY_STORE=1
DEV_FAKE_AI=1
DEV_AUTH=1
# Or real services:
# SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
# SUPABASE_SECRET_KEY=...
# GROQ_API_KEY=...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_PLAN_IDS={"creator_monthly":"plan_XXXXXX","pro_monthly":"plan_YYYYYY","studio_monthly":"plan_ZZZZZZ"}
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# ADMIN_USER_IDS=your-supabase-user-uuid
